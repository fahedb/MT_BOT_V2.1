# ---------------------------------------------------------------------------
# Static analysis for code written during and after the refactor.
#
# Scope note: the legacy tree would emit tens of thousands of diagnostics, so
# clang-tidy is applied to libs/, apps/ and tests/ only, and is widened module
# by module as Phase 1 cleans each one up. The checks chosen here are the ones
# that catch the specific classes of defect recorded in docs/REFACTOR_PLAN.md
# section 4 (raw owning pointers, implicit narrowing, uninitialised state).
# ---------------------------------------------------------------------------
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers

WarningsAsErrors: ''

HeaderFilterRegex: '(libs|apps|tests)/.*\.(h|hpp)$'

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.ConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantPrefix
    value: k
  - key: readability-braces-around-statements.ShortStatementLines
    value: '2'
