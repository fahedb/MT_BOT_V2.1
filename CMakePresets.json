{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MTBOT_BUILD_TESTS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "vs2022-debug",
      "displayName": "VS 2022 x64 (Debug)",
      "description": "Default developer build. Uses the vcpkg installation found via VCPKG_ROOT or C:/vcpkg.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "vs2022-release",
      "displayName": "VS 2022 x64 (Release)",
      "inherits": "vs2022-debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "vs2022-legacy",
      "displayName": "VS 2022 x64 (Debug, full legacy tree)",
      "description": "Adds mt_legacy_core, the whole pre-refactor engine. Needs the CUDA Toolkit headers and cairo. Build this one with --parallel 1 or 2: the legacy sources are memory-hungry to compile.",
      "inherits": "vs2022-debug",
      "cacheVariables": {
        "MTBOT_BUILD_LEGACY_FULL": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja (Debug)",
      "description": "Faster iteration; needs ninja and a developer command prompt on PATH.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja (Release)",
      "inherits": "ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "vs2022-legacy",
      "configurePreset": "vs2022-legacy",
      "configuration": "Debug",
      "jobs": 1
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release"
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
